{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // سكربتات الفحص pentest-*.ts (فحص أمني 2026-10-21): أدوات اختراق تُشغَّل بـbun
    // فوق خادم حي (أعلى await وأنواع فضفاضة كسائر اختبارات API القديمة التي تحمل
    // أصلًا خط الأساس 130)؛ مُصادق عليها بالتنفيذ الفعلي (473 فحصًا) لا بالتحقق
    // النوعي — استثناؤها يحفظ ميزانية بوابة الجودة دون رفع (لا رفع إلا بقرار موثّق).
    "tests/pentest-*.ts"
  ]
}
